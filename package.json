{
  "name": "crypto-lab-stego-suite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run test:publish-request && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "playwright test",
    "check": "npm run typecheck && npm run test && npm run build",
    "deploy": "gh workflow run deploy.yml --repo systemslibrarian/crypto-lab-stego-suite --ref main",
    "test:claims": "playwright test e2e/first-look.spec.ts",
    "test:front-a11y": "playwright test e2e/first-look-a11y.spec.ts",
    "test:mutations": "node scripts/mutate.mjs",
    "test:publish-request": "node --test tests/publish-request.node.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
